{
    "name": "phalcon/volt",
    "description": "Phalcon Volt is an HTML template engine for server-side rendering.",
    "type": "library",
    "keywords": [
        "phalcon",
        "volt",
        "template",
        "engine",
        "html"
    ],
    "homepage": "https://phalcon.io",
    "license": "MIT",
    "authors": [
        {
            "name": "Phalcon Team",
            "email": "team@phalcon.io",
            "homepage": "https://phalcon.io/en/team"
        },
        {
            "name": "Contributors",
            "homepage": "https://github.com/phalcon/volt/graphs/contributors"
        }
    ],
    "support": {
        "email": "support@phalcon.io",
        "issues": "https://github.com/phalcon/volt/issues",
        "source": "https://github.com/phalcon/volt",
        "discussions": "https://phalcon.io/discussions/",
        "docs": "https://phalcon.io/docs/",
        "rss": "https://blog.phalcon.io/rss"
    },
    "require": {
        "php": ">=8.1 <9.0",
        "ext-ctype": "*",
        "ext-mbstring": "*"
    },
    "suggest": {
        "phalcon/phalcon": "The Phalcon framework this module integrates with"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "pds/skeleton": "^1.0",
        "phalcon/ide-stubs": "^5.8",
        "phalcon/talon": "^0.6.0 || ^0.8.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true
        }
    },
    "autoload": {
        "psr-4": {
            "Phalcon\\Volt\\": "src/"
        },
        "files": [
            "resources/files/parser.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Phalcon\\Tests\\Unit\\": "tests/unit/"
        }
    },
    "scripts": {
        "analyze": "vendor/bin/phpstan analyse -c resources/phpstan.neon --memory-limit 1024M",
        "cs": "vendor/bin/phpcs --standard=resources/phpcs.xml",
        "cs-fix": "vendor/bin/phpcbf --standard=resources/phpcs.xml",
        "cs-fixer": "vendor/bin/php-cs-fixer fix --config=resources/php-cs-fixer.php --dry-run --diff",
        "cs-fixer-fix": "vendor/bin/php-cs-fixer fix --config=resources/php-cs-fixer.php",
        "test-unit": "talon run unit",
        "test-unit-coverage": "talon run unit -- --coverage-clover tests/_output/coverage.xml --coverage-php tests/_output/coverage.cov",
        "test-unit-coverage-html": "talon run unit -- --coverage-html tests/_output/coverage/",
        "test-all": "talon run all"
    }
}
